{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hume-fragrance",
  "workers_dev": true,
  "limits": {
    "cpu_ms": 30000
  },
  "main": "custom-worker.mjs",
  "triggers": { "crons": ["15 * * * *"] },
  "compatibility_date": "2025-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "4a05896cbc694e9f99033c7374ec7358",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "humefragrance.com", "custom_domain": true },
    { "pattern": "www.humefragrance.com", "custom_domain": true },
    { "pattern": "humefragrance.in", "custom_domain": true },
    { "pattern": "www.humefragrance.in", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
