# AI provider secrets (models and runtime settings live in lib/ai/config.ts)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Protects Vercel cron endpoints
CRON_SECRET=

# Cloudinary (server-only credentials)
# You can use CLOUDINARY_URL instead of the three variables below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram admin alerts and website live chat
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
# Public production origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://humefragrance.com

# Checkout and diagnostics are enabled by default; apply additive SQL schemas before deployment.
# Optional overrides (not required): ENABLE_SECURE_CHECKOUT=false, ENABLE_ERROR_MONITORING=false.
# Optional dedicated CHECKOUT_SESSION_SIGNING_SECRET; otherwise derived from RAZORPAY_KEY_SECRET.
# Use matching test-mode keys on an isolated preview; retain live keys in production.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Private diagnostics; optional HTTPS receiver for sanitized error alerts.
ERROR_ALERT_WEBHOOK_URL=
# Keep local customer notifications off during development.
ENABLE_LOCAL_CUSTOMER_NOTIFICATIONS=false

# Delhivery live shipment tracking (server-only; never use a NEXT_PUBLIC_ key)
DELHIVERY_API_TOKEN=
# Optional: defaults to the production endpoint below.
# For staging use https://staging-express.delhivery.com/api/v1/packages/json/
DELHIVERY_TRACKING_ENDPOINT=https://track.delhivery.com/api/v1/packages/json/

# Private Google Sheets weekly business backups (server-only)
GOOGLE_BACKUP_CLIENT_ID=
GOOGLE_BACKUP_CLIENT_SECRET=
GOOGLE_BACKUP_REDIRECT_URI=https://www.humefragrance.com/api/admin/backups/google/callback
# Base64-encoded 32-byte AES key. Keep stable; changing it requires reconnecting Google.
GOOGLE_BACKUP_ENCRYPTION_KEY=
